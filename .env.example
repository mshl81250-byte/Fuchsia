# MySQL connection string for the Express API (Drizzle mysql2)
DATABASE_URL=mysql://user:<password>@host:3306/fuchsia
PORT=5000

# External notification channels (keep these values in deployment secrets)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
RESEND_API_KEY=
EMAIL_FROM=notifications@fuchsia.ye
EMAIL_LOGO_URL=https://fuchsia.ye/logo.png
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_INITIAL_PASSWORD=replace-with-a-random-password-at-least-12-characters
