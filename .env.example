# Supabase PostgreSQL connection string for the Express API
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
PORT=5000

# External notification channels (keep these values in deployment secrets)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
RESEND_API_KEY=
EMAIL_FROM=notifications@fuchsia.ye
EMAIL_LOGO_URL=https://fuchsia.ye/logo.png
SESSION_SECRET=replace-with-a-long-random-secret
