# Supabase PostgreSQL connection string for the Express API
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
PORT=5000

# External notification channels (keep these values in deployment secrets)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
RESEND_API_KEY=
EMAIL_FROM=notifications@fuchsia.ye
EMAIL_LOGO_URL=https://fuchsia.ye/logo.png
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_INITIAL_PASSWORD=replace-with-a-random-password-at-least-12-characters

# Firebase Cloud Messaging HTTP v1 service account (server secrets only)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Development-only: show generated registration OTP inside the mobile app.
# Keep false or unset when real email OTP is enabled.
MOBILE_OTP_DEBUG=false

# S3-compatible public image storage (Cloudflare R2, Backblaze B2, AWS S3, etc.)
# Keep credentials in the deployment's secret manager; never commit real values.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Public HTTPS base URL for objects (custom CDN/domain preferred)
OBJECT_STORAGE_PUBLIC_BASE_URL=
